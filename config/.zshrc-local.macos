# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# fzf (key bindings need a TTY; without one, sourcing them errors with
# "can't change option: zle")
[ -t 0 ] && [ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh

# NVM (installed via Brewfile)
export NVM_DIR="$HOME/.nvm"
[ -s /opt/homebrew/opt/nvm/nvm.sh ] && \. /opt/homebrew/opt/nvm/nvm.sh
