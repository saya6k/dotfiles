[core]
	editor = vim
	excludesfile = ~/.gitignore

[pull]
	ff = only

[color]
	diff = auto
	status = auto
	branch = auto
	ui = true

[apply]
	whitespace = nowarn

[mergetool]
	keepBackup = false

[difftool]
	prompt = false

[grep]
	linenumber = true

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[init]
	defaultBranch = main

[rerere]
	enabled = true

# user.name / user.email live here so they stay out of this public repo.
# install.sh creates it, migrating the values from any pre-existing ~/.gitconfig.
[include]
	path = ~/.gitconfig.local
