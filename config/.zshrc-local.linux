# fzf (key bindings need a TTY; without one, e.g. `docker exec` without -t,
# sourcing them errors with "can't change option: zle")
[ -t 0 ] && [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh

# NVM (installed by install-linux.sh)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
