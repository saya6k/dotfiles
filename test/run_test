#!/bin/bash
# Build a dev container image and run install.sh inside it.
#
# On a Mac `docker` talks to socktainer (see config/AGENTS.md), so this runs as is.
set -e
cd "$(dirname "$0")/.."

docker build . -t dotfiles -f test/Dockerfile.test --force-rm

docker run --rm -it dotfiles

docker rmi dotfiles
